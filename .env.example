# 复制为 .env 并填写真实值
VITE_SUPABASE_URL=https://your-instance.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 邮件服务（Netlify Functions 站点）基地址，如 https://lrcshare-mail.netlify.app
# 本地开发也直接指向生产 Netlify 站点；SUPABASE_SERVICE_ROLE_KEY 只配置在 Netlify 云端环境变量，本地/仓库均不存放
# 留空 = 不发邮件（审核流程照常，仅跳过通知）
# 用途：审核结果通知投稿人（approve/reject）+ 新投稿通知站长（notify，投稿页提交成功后触发）
#       图片灾备转存（/api/image-backup）也走该基地址
VITE_MAIL_BASE=

# 注：OSS_REGION / OSS_BUCKET / OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET
#     仅配置在 Netlify 云端环境变量（转存函数使用，绝不下发浏览器）；
#     本地跑 scripts/backup-images.mjs 存量回填时在当前终端会话临时设置即可。
