-- ⑤ 自定义函数（RPC）完整定义
[
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.get_top_artists(limit_count integer DEFAULT 6)\n RETURNS TABLE(id text, name text, sort integer, avatar text, types text[], disambiguation text, is_show boolean, aliases text[], song_count integer)\n LANGUAGE sql\n STABLE\nAS $function$\r\n  WITH song_artist_pairs AS (\r\n    SELECT s.id AS song_id, unnest(s.artist_ids) AS artist_id\r\n    FROM songs s WHERE s.status = 'published' AND s.artist_ids IS NOT NULL\r\n    UNION  -- 去重：一首歌对一个艺术家只算一次（演唱/作词/作曲/编曲多身份合一）\r\n    SELECT s.id, unnest(string_to_array(s.lyricist, ','))\r\n    FROM songs s WHERE s.lyricist IS NOT NULL AND s.status = 'published'\r\n    UNION\r\n    SELECT s.id, unnest(string_to_array(s.composer, ','))\r\n    FROM songs s WHERE s.composer IS NOT NULL AND s.status = 'published'\r\n    UNION\r\n    SELECT s.id, unnest(string_to_array(s.arranger, ','))\r\n    FROM songs s WHERE s.arranger IS NOT NULL AND s.status = 'published'\r\n  ),\r\n  song_artist_counts AS (\r\n    SELECT artist_id, COUNT(*) AS cnt\r\n    FROM song_artist_pairs\r\n    WHERE artist_id IS NOT NULL AND artist_id <> ''\r\n    GROUP BY artist_id\r\n  )\r\n  SELECT\r\n    a.id, a.name, a.sort, a.avatar, a.types, a.disambiguation, a.is_show, a.aliases,\r\n    COALESCE(c.cnt, 0) AS song_count\r\n  FROM artists a\r\n  LEFT JOIN song_artist_counts c ON c.artist_id = a.id\r\n  WHERE a.is_show IS NOT FALSE\r\n  ORDER BY\r\n    CASE WHEN a.sort > 0 THEN 0 ELSE 1 END,\r\n    CASE WHEN a.sort > 0 THEN a.sort END NULLS LAST,\r\n    COALESCE(c.cnt, 0) DESC,\r\n    a.name ASC\r\n  LIMIT limit_count;\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.get_top_contributors(limit_count integer DEFAULT 9)\n RETURNS TABLE(id text, name text, avatar text, bio text, public_bio boolean, contact_value text, public_contact boolean, is_owner boolean, created_at timestamp with time zone, sort integer, tags text[], song_count integer)\n LANGUAGE sql\n STABLE\nAS $function$\r\n  WITH contributor_counts AS (\r\n    SELECT contributor_id, COUNT(*) as cnt\r\n    FROM songs\r\n    WHERE status = 'published' AND contributor_id IS NOT NULL\r\n    GROUP BY contributor_id\r\n  )\r\n  SELECT\r\n    c.id, c.name, c.avatar, c.bio, c.public_bio, c.contact_value,\r\n    c.public_contact, c.is_owner, c.created_at, c.sort, c.tags,\r\n    COALESCE(cc.cnt, 0) as song_count\r\n  FROM contributors c\r\n  LEFT JOIN contributor_counts cc ON cc.contributor_id = c.id\r\n  ORDER BY\r\n    CASE WHEN c.sort > 0 THEN 0 ELSE 1 END,\r\n    CASE WHEN c.sort > 0 THEN c.sort END NULLS LAST,\r\n    COALESCE(cc.cnt, 0) DESC,\r\n    c.created_at ASC\r\n  LIMIT limit_count;\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.performer_hit(p_artist_ids text[], p_txt text)\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\r\n  select exists (\r\n    select 1\r\n    from public.artists ar\r\n    where ar.is_show is not false\r\n      and ar.id = any(p_artist_ids)\r\n      and (\r\n        ar.name ilike '%' || p_txt || '%'\r\n        or exists (select 1 from unnest(coalesce(ar.aliases, '{}')) al where al ilike '%' || p_txt || '%')\r\n      )\r\n  )\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.recompute_artist_types(p_artist_ids text[] DEFAULT NULL::text[])\n RETURNS void\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n  UPDATE public.artists a\r\n  SET types = (\r\n    SELECT COALESCE(array_agg(DISTINCT role), '{}'::text[])\r\n    FROM (\r\n      -- 演唱或专辑艺术家 → singer\r\n      SELECT 'singer'::text AS role\r\n      WHERE EXISTS (SELECT 1 FROM public.songs s WHERE a.id = ANY(s.artist_ids))\r\n         OR EXISTS (SELECT 1 FROM public.albums al WHERE a.id = ANY(al.artist_ids))\r\n      UNION ALL\r\n      SELECT 'lyricist'::text\r\n      WHERE EXISTS (SELECT 1 FROM public.songs s WHERE a.id = ANY(string_to_array(s.lyricist, ',')))\r\n      UNION ALL\r\n      SELECT 'composer'::text\r\n      WHERE EXISTS (SELECT 1 FROM public.songs s WHERE a.id = ANY(string_to_array(s.composer, ',')))\r\n      UNION ALL\r\n      SELECT 'arranger'::text\r\n      WHERE EXISTS (SELECT 1 FROM public.songs s WHERE a.id = ANY(string_to_array(s.arranger, ',')))\r\n    ) r\r\n  )\r\n  WHERE p_artist_ids IS NULL OR a.id = ANY(p_artist_ids);\r\nEND;\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.search_albums_structured(p_name text DEFAULT NULL::text, p_artist text DEFAULT NULL::text)\n RETURNS SETOF albums\n LANGUAGE sql\n STABLE\nAS $function$\r\n  select a.*\r\n  from public.albums a\r\n  where (\r\n    p_name is null\r\n    or a.name ilike '%' || p_name || '%'\r\n  )\r\n  and (\r\n    p_artist is null\r\n    or exists (\r\n      select 1\r\n      from public.artists ar\r\n      where ar.is_show is not false\r\n        and ar.id = any(a.artist_ids)\r\n        and (\r\n          ar.name ilike '%' || p_artist || '%'\r\n          or exists (select 1 from unnest(coalesce(ar.aliases, '{}')) al where al ilike '%' || p_artist || '%')\r\n        )\r\n    )\r\n  )\r\n  order by a.name asc\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.search_songs(p_q text)\n RETURNS SETOF songs\n LANGUAGE plpgsql\n STABLE\nAS $function$\r\n      declare\r\n        tokens text[] := array(\r\n          select t from regexp_split_to_table(trim(coalesce(p_q, '')), '\\s+') t where t <> ''\r\n        );\r\n      begin\r\n        if cardinality(tokens) = 0 then\r\n          return;\r\n        end if;\r\n\r\n        return query\r\n        select id, title, album_id, lyricist, composer, arranger, duration, lrc_text, status, created_at, track, contributor_id, lyrics_text, video_url, description, is_hidden, null::text as unlock_code, genres, artist_ids, disc, cover, aliases\r\n        from public.songs s\r\n        where s.status = 'published'\r\n          -- AND 过滤：每个 token 必须有家，一个无家可归即淘汰\r\n          and not exists (\r\n            select 1 from unnest(tokens) tok\r\n            where not (\r\n                 song_title_hit(s.title, s.aliases, tok)\r\n              or song_artist_hit(s.artist_ids, s.lyricist, s.composer, s.arranger, tok)\r\n            )\r\n          )\r\n        order by\r\n          struct_hit(s.title, s.aliases, s.artist_ids, tokens) desc,\r\n          (\r\n            select coalesce(sum(song_token_weight(s.title, s.aliases, s.artist_ids, tok)), 0)\r\n            from unnest(tokens) tok\r\n          ) desc,\r\n          s.title asc;\r\n      end\r\n    $function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.search_songs_structured(p_title text DEFAULT NULL::text, p_artist text DEFAULT NULL::text)\n RETURNS SETOF songs\n LANGUAGE sql\n STABLE\nAS $function$\r\n      select id, title, album_id, lyricist, composer, arranger, duration, lrc_text, status, created_at, track, contributor_id, lyrics_text, video_url, description, is_hidden, null::text as unlock_code, genres, artist_ids, disc, cover, aliases\r\n      from public.songs s\r\n      where s.status = 'published'\r\n        and (\r\n          p_title is null\r\n          or s.title ilike '%' || p_title || '%'\r\n          or exists (select 1 from unnest(coalesce(s.aliases, '{}')) a where a ilike '%' || p_title || '%')\r\n        )\r\n        and (\r\n          p_artist is null\r\n          or exists (\r\n            select 1\r\n            from public.artists ar\r\n            where ar.is_show is not false\r\n              and ar.id = any(s.artist_ids)\r\n              and (\r\n                ar.name ilike '%' || p_artist || '%'\r\n                or exists (select 1 from unnest(coalesce(ar.aliases, '{}')) al where al ilike '%' || p_artist || '%')\r\n              )\r\n          )\r\n        )\r\n      order by s.title asc\r\n    $function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.song_artist_hit(p_artist_ids text[], p_lyricist text, p_composer text, p_arranger text, p_tok text)\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\r\n  select exists (\r\n    select 1\r\n    from public.artists ar\r\n    where ar.is_show is not false\r\n      and (\r\n        ar.id = any(p_artist_ids)\r\n        or ar.id = any(string_to_array(coalesce(p_lyricist, ''), ','))\r\n        or ar.id = any(string_to_array(coalesce(p_composer, ''), ','))\r\n        or ar.id = any(string_to_array(coalesce(p_arranger, ''), ','))\r\n      )\r\n      and (\r\n        ar.name ilike '%' || p_tok || '%'\r\n        or exists (select 1 from unnest(coalesce(ar.aliases, '{}')) al where al ilike '%' || p_tok || '%')\r\n      )\r\n  )\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.song_title_hit(p_title text, p_aliases text[], p_tok text)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\nAS $function$\r\n  select p_title ilike '%' || p_tok || '%'\r\n    or exists (select 1 from unnest(coalesce(p_aliases, '{}')) a where a ilike '%' || p_tok || '%')\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.song_token_weight(p_title text, p_aliases text[], p_artist_ids text[], p_tok text)\n RETURNS numeric\n LANGUAGE sql\n STABLE\nAS $function$\r\n  select case\r\n    when p_title ilike '%' || p_tok || '%' then 3\r\n    when exists (select 1 from unnest(coalesce(p_aliases, '{}')) a where a ilike '%' || p_tok || '%') then 2\r\n    when performer_hit(p_artist_ids, p_tok) then 1\r\n    else 0.5\r\n  end\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.struct_hit(p_title text, p_aliases text[], p_artist_ids text[], p_tokens text[])\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\r\n  select exists (\r\n    select 1\r\n    from generate_series(1, cardinality(p_tokens) - 1) i\r\n    where (\r\n            song_title_hit(p_title, p_aliases, array_to_string(p_tokens[1:i], ' '))\r\n        and performer_hit(p_artist_ids, array_to_string(p_tokens[i+1:cardinality(p_tokens)], ' '))\r\n      )\r\n       or (\r\n            performer_hit(p_artist_ids, array_to_string(p_tokens[1:i], ' '))\r\n        and song_title_hit(p_title, p_aliases, array_to_string(p_tokens[i+1:cardinality(p_tokens)], ' '))\r\n      )\r\n  )\r\n$function$\n"
  },
  {
    "pg_get_functiondef": "CREATE OR REPLACE FUNCTION public.verify_hidden_unlock_code(p_song_id text, p_code text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare\r\n  v_global text;\r\n  v_song text;\r\nbegin\r\n  if p_code is null or btrim(p_code) = '' then\r\n    return false;\r\n  end if;\r\n\r\n  -- 全局口令（settings 受 RLS 保护，security definer 以函数属主身份读取，绕过 RLS）\r\n  select s.value into v_global\r\n  from public.settings s\r\n  where s.key = 'hidden_unlock_code';\r\n\r\n  if v_global is not null and v_global <> '' and p_code = v_global then\r\n    return true;\r\n  end if;\r\n\r\n  -- 歌曲独立口令\r\n  if p_song_id is not null then\r\n    select t.unlock_code into v_song\r\n    from public.songs t\r\n    where t.id = p_song_id;\r\n\r\n    if v_song is not null and v_song <> '' and p_code = v_song then\r\n      return true;\r\n    end if;\r\n  end if;\r\n\r\n  return false;\r\nend;\r\n$function$\n"
  }
]

